{
  "name": "HcourtMobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:apk": "cd android && gradlew.bat assembleRelease",
    "android:aab": "cd android && gradlew.bat bundleRelease",
    "ios": "react-native run-ios",
    "ios:build": "npx eas-cli@latest build --platform ios --profile production --non-interactive",
    "ios:submit": "npx eas-cli@latest submit --platform ios --profile production --latest --non-interactive",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "postinstall": "node scripts/patch-metro-image-size.cjs && node scripts/patch-hot-updater-windows.cjs",
    "ota": "node scripts/ota.cjs",
    "ota:publish": "node scripts/ota.cjs deploy --channel production",
    "ota:check": "node scripts/ota.cjs doctor"
  },
  "dependencies": {
    "@hot-updater/react-native": "1.1.4",
    "@invertase/react-native-apple-authentication": "2.5.1",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-blob-util": "^0.24.10",
    "react-native-config": "^1.7.2",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "^15.16.0",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@hot-updater/aws": "1.1.4",
    "@hot-updater/bare": "1.1.4",
    "@hot-updater/standalone": "1.1.4",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "hot-updater": "1.1.4",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "overrides": {
    "deepmerge": "4.1.1",
    "image-size": "2.0.4",
    "hono": "4.13.11"
  }
}
